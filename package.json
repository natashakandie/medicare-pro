  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.18.0",
    "mysql2": "^3.22.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
