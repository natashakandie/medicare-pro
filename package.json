{
  "name": "medicare-pro",
  "version": "1.1.0",
  "description": "MediCore Pro: a hospital management system built with Node.js, Express, EJS and MySQL",
  "main": "hospital-management-system/server.js",
  "scripts": {
    "start": "node hospital-management-system/server.js",
    "dev": "nodemon hospital-management-system/server.js",
    "db:setup": "node hospital-management-system/scripts/setup-db.js",
    "db:healthcheck": "node hospital-management-system/scripts/healthcheck.js",
    "test": "node --test hospital-management-system/test"
  },
  "keywords": [
    "hospital",
    "dashboard",
    "express",
    "ejs",
    "mysql"
  ],
