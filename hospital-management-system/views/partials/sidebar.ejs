<button class="mobile-nav-toggle" type="button" aria-label="Toggle menu" aria-controls="sidebar" aria-expanded="false">
  <%- icon('menu') %>
  <span>Menu</span>
</button>

<aside class="sidebar" id="sidebar">
  <div class="brand-block">
    <img
      class="brand-logo"
      src="/images/medicore-logo.svg"
      alt="MediCore Pro logo"
    />
    <div>
      <h3>MediCore Pro</h3>
      <p>Hospital Command Center</p>
    </div>
  </div>

  <form class="sidebar-search" action="/patients" method="GET">
    <%- icon('search') %>
    <input type="search" name="q" placeholder="Search patients..." />
  </form>

  <nav class="nav-links">
    <% (typeof navPages !== 'undefined' ? navPages : []).forEach((page) => { %>
      <a
        class="<%= currentPath === page.href || currentPath.startsWith(page.href + '/') ? 'active' : '' %>"
        href="<%= page.href %>"
      >
        <%- icon(page.key) %>
        <span><%= page.label %></span>
        <% if (page.key === 'notifications' && typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="nav-badge"><%= unreadCount %></span>
        <% } %>
      </a>
    <% }) %>
  </nav>

  <div class="sidebar-card">
    <div class="sidebar-user">
      <span class="avatar"><%= typeof user !== 'undefined' && user ? fmt.initials(user.name) : '?' %></span>
      <div>
        <strong><%= typeof user !== 'undefined' && user ? user.name : 'Guest' %></strong>
        <small><%= typeof user !== 'undefined' && user ? user.role : '' %></small>
      </div>
    </div>
    <a class="btn btn-secondary sidebar-logout" href="/logout">
      <%- icon('logout') %>
      <span>Logout</span>
    </a>
  </div>
</aside>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
