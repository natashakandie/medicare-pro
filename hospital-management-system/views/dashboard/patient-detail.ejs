<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="page-shell">
      <%- include('../partials/sidebar') %>
      <main class="main-content">
        <header class="topbar">
          <div class="row-actions">
            <span class="avatar"><%= fmt.initials(patient.full_name) %></span>
            <div>
              <p class="eyebrow">Electronic medical record</p>
              <h1><%= patient.full_name %></h1>
            </div>
          </div>
          <a class="btn btn-secondary" href="/patients">Back to patients</a>
        </header>

        <%- include('../partials/alerts') %>

        <section class="profile-grid">
          <article class="panel">
            <div class="panel-header">
              <h3>Patient profile</h3>
              <span class="badge"><%= patient.patient_code || '-' %></span>
            </div>
            <dl class="detail-list">
              <div><dt>Date of birth</dt><dd><%= fmt.formatDate(patient.date_of_birth) %><% var age = fmt.ageFrom(patient.date_of_birth); %><% if (age !== null) { %> (<%= age %> yrs)<% } %></dd></div>
              <div><dt>Gender</dt><dd><%= patient.gender || '-' %></dd></div>
              <div><dt>Blood group</dt><dd><%= patient.blood_group || '-' %></dd></div>
              <div><dt>Phone</dt><dd><%= patient.phone || '-' %></dd></div>
              <div><dt>Emergency contact</dt><dd><%= patient.emergency_contact || '-' %></dd></div>
              <div><dt>Allergies</dt><dd><%= patient.allergies || '-' %></dd></div>
              <div><dt>History</dt><dd><%= patient.medical_history || '-' %></dd></div>
            </dl>
          </article>

          <article class="panel">
            <div class="panel-header">
              <h3>Appointments</h3>
              <a href="/appointments">Manage</a>
            </div>
            <ul class="activity-list">
              <% if (appointments.length) { %>
                <% appointments.forEach((appointment) => { %>
                  <li>
                    <span><%= fmt.formatDateTime(appointment.appointment_date) %> - <%= appointment.doctor_name %></span>
                    <small><%= appointment.reason || 'No reason given' %> &bull; <span class="status-pill <%= appointment.status %>"><%= appointment.status %></span></small>
                  </li>
                <% }) %>
              <% } else { %>
                <li class="empty-row">No appointments on file.</li>
              <% } %>
            </ul>
          </article>
        </section>

        <section class="content-grid">
          <article class="panel">
            <div class="panel-header">
              <h3>Visit notes and prescriptions</h3>
              <span class="badge"><%= visits.length %> visits</span>
            </div>
            <ul class="activity-list">
              <% if (visits.length) { %>
                <% visits.forEach((visit) => { %>
                  <li>
                    <span><%= fmt.formatDate(visit.created_at) %> - <%= visit.doctor_name || 'Unassigned' %></span>
                    <small><%= visit.symptoms %><% if (visit.diagnosis) { %> | <%= visit.diagnosis %><% } %></small>
                    <p><%= visit.vitals || 'No vitals recorded' %><% if (visit.notes) { %> | <%= visit.notes %><% } %></p>
                  </li>
                <% }) %>
              <% } else { %>
                <li class="empty-row">No visit notes on file.</li>
              <% } %>
            </ul>
          </article>

          <article class="panel">
            <div class="panel-header">
              <h3>Invoices</h3>
              <a href="/billing">Billing</a>
            </div>
            <ul class="activity-list">
              <% if (invoices.length) { %>
                <% invoices.forEach((invoice) => { %>
                  <li><span><%= invoice.invoice_code %></span><small><%= fmt.formatMoney(invoice.total_amount) %> &bull; <span class="status-pill <%= invoice.status %>"><%= invoice.status %></span></small></li>
                <% }) %>
              <% } else { %>
                <li class="empty-row">No invoices for this patient.</li>
              <% } %>
            </ul>
          </article>
        </section>
      </main>
    </div>
  </body>
</html>
