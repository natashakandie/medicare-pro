<!DOCTYPE html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title><%= title %></title><link rel="stylesheet" href="/css/style.css" /></head>
  <body>
    <div class="page-shell">
      <%- include('../partials/sidebar') %>
      <main class="main-content">
        <header class="topbar"><div><p class="eyebrow">Account</p><h1>Settings</h1></div></header>

        <%- include('../partials/alerts') %>

        <section class="profile-grid">
          <article class="panel">
            <div class="panel-header"><h3>Profile</h3><span class="badge"><%= user.role %></span></div>
            <form class="form-grid" method="POST" action="/settings/profile">
              <label>Full name<input name="full_name" value="<%= user.name %>" required /></label>
              <label>Email<input value="<%= user.email %>" disabled /></label>
              <div class="form-actions full-width">
                <button class="btn btn-primary" type="submit">Save profile</button>
              </div>
            </form>
          </article>

          <article class="panel">
            <div class="panel-header"><h3>Change password</h3></div>
            <form class="form-grid" method="POST" action="/settings/password">
              <label class="full-width">Current password<input type="password" name="current_password" autocomplete="current-password" required /></label>
              <label>New password<input type="password" name="new_password" autocomplete="new-password" minlength="8" required /></label>
              <label>Confirm new password<input type="password" name="confirm_password" autocomplete="new-password" minlength="8" required /></label>
              <div class="form-actions full-width">
                <button class="btn btn-primary" type="submit">Update password</button>
              </div>
            </form>
          </article>
        </section>

        <section class="panel">
          <div class="panel-header"><h3>Demo login accounts</h3></div>
          <p class="empty-state">Use these to sign in as a different role while presenting the app.</p>
          <ul class="demo-account-list">
            <% demoAccounts.forEach((account) => { %>
              <li><span><%= account.email %></span><code><%= account.password %></code></li>
            <% }) %>
          </ul>
        </section>
      </main>
    </div>
  </body>
</html>
