<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="page-shell">
      <%- include('../partials/sidebar') %>
      <main class="main-content">
        <header class="topbar"><div><p class="eyebrow">Analytics</p><h1>Reports Dashboard</h1></div></header>

        <%- include('../partials/alerts') %>

        <section class="stats-grid">
          <article class="metric-card"><span>Revenue collected</span><strong><%= fmt.formatMoney(revenue) %></strong></article>
          <article class="metric-card"><span>Appointments</span><strong><%= totalAppointments %></strong></article>
          <article class="metric-card"><span>Most dispensed medicine</span><strong><%= topMedicine %></strong></article>
          <article class="metric-card"><span>Low stock items</span><strong><%= medicines.filter((item) => item.stock_quantity <= item.reorder_level).length %></strong></article>
        </section>
        <section class="chart-grid">
          <article class="panel">
            <div class="panel-header"><h3>Appointments by status</h3></div>
            <div class="bar-list">
              <% var maxCount = Math.max(1, ...statusCounts.map((s) => s.count)); %>
              <% statusCounts.forEach((row) => { %>
                <div style="--value: <%= Math.round((row.count / maxCount) * 100) %>%"><%= row.status %> (<%= row.count %>)</div>
              <% }) %>
              <% if (!statusCounts.length) { %><p class="empty-state">No appointment data yet.</p><% } %>
            </div>
          </article>
          <article class="panel">
            <div class="panel-header"><h3>Pharmacy stock levels</h3></div>
            <div class="bar-list">
              <% medicines.forEach((medicine) => { %><div style="--value: <%= Math.min(medicine.stock_quantity / 4, 100) %>%"><%= medicine.name %> (<%= medicine.stock_quantity %>)</div><% }) %>
            </div>
          </article>
        </section>
      </main>
    </div>
  </body>
</html>
