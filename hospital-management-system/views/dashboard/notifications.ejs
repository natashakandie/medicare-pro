<!DOCTYPE html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title><%= title %></title><link rel="stylesheet" href="/css/style.css" /></head>
  <body>
    <div class="page-shell">
      <%- include('../partials/sidebar') %>
      <main class="main-content">
        <header class="topbar">
          <div><p class="eyebrow">Notifications</p><h1>In-App Notification Center</h1></div>
          <% if (notifications.some((n) => !n.is_read)) { %>
            <form method="POST" action="/notifications/read-all">
              <button class="btn btn-secondary" type="submit">Mark all as read</button>
            </form>
          <% } %>
        </header>

        <%- include('../partials/alerts') %>

        <section class="panel">
          <ul class="activity-list">
            <% notifications.forEach((notification) => { %>
              <li class="<%= notification.is_read ? 'read-row' : '' %>">
                <span><%= notification.title %><% if (!notification.is_read) { %><span class="unread-badge">new</span><% } %></span>
                <small><%= notification.message %> &bull; <%= fmt.relativeTime(notification.created_at) %></small>
                <% if (!notification.is_read) { %>
                  <form method="POST" action="/notifications/<%= notification.id %>/read" style="margin-top: 6px">
                    <button class="btn btn-secondary btn-sm" type="submit">Mark as read</button>
                  </form>
                <% } %>
              </li>
            <% }) %>
            <% if (!notifications.length) { %><li class="empty-row">No notifications yet.</li><% } %>
          </ul>
        </section>
      </main>
    </div>
  </body>
</html>
