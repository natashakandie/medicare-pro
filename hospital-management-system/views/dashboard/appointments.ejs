<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="page-shell">
      <%- include('../partials/sidebar') %>
      <main class="main-content">
        <header class="topbar">
          <div>
            <p class="eyebrow">Appointments</p>
            <h1>Schedule Overview</h1>
          </div>
          <a class="btn btn-primary" href="/dashboard">Back to dashboard</a>
        </header>

        <section class="hero-card">
          <div>
            <h2>Coordinate visits and follow-ups</h2>
            <p>The appointment system is backed by the hospital database.</p>
          </div>
          <div class="hero-pill">Upcoming</div>
        </section>

        <%- include('../partials/alerts') %>

        <% if (typeof user !== 'undefined' && user && user.role !== 'Patient') { %>
        <section class="form-card">
          <div class="panel-header">
            <h3>Book appointment</h3>
          </div>
          <form class="form-grid" method="POST" action="/appointments">
            <label>Patient<select name="patient_id" required>
              <option value="">Select patient</option>
              <% patients.forEach((patient) => { %>
                <option value="<%= patient.id %>"><%= patient.full_name %></option>
              <% }) %>
            </select></label>
            <label>Doctor<select name="doctor_id" required>
              <option value="">Select doctor</option>
              <% doctors.forEach((doctor) => { %>
                <option value="<%= doctor.id %>"><%= doctor.full_name %></option>
              <% }) %>
            </select></label>
            <label>Appointment date<input type="datetime-local" name="appointment_date" required /></label>
            <label>Status<select name="status"><option value="scheduled">Scheduled</option><option value="confirmed">Confirmed</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option></select></label>
            <label class="full-width">Reason<textarea name="reason" rows="2"></textarea></label>
            <label class="full-width">Notes<textarea name="notes" rows="2"></textarea></label>
            <div class="form-actions full-width">
              <button class="btn btn-primary" type="submit">Book appointment</button>
            </div>
          </form>
        </section>
        <% } %>

        <section class="panel">
          <div class="panel-header">
            <h3>Appointments</h3>
            <span class="badge"><%= appointments.length %> entries</span>
          </div>
          <% if (appointments.length) { %>
            <div class="table-wrap">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <% if (typeof user !== 'undefined' && user && user.role !== 'Patient') { %><th>Update</th><% } %>
                  </tr>
                </thead>
                <tbody>
                  <% appointments.forEach((appointment) => { %>
                    <tr>
                      <td><%= appointment.patient_name %></td>
                      <td><%= appointment.doctor_name %></td>
                      <td><%= fmt.formatDateTime(appointment.appointment_date) %></td>
                      <td><%= appointment.reason || '-' %></td>
                      <td><span class="status-pill <%= appointment.status %>"><%= appointment.status %></span></td>
                      <% if (typeof user !== 'undefined' && user && user.role !== 'Patient') { %>
                      <td>
                        <form class="inline-form" method="POST" action="/appointments/<%= appointment.id %>/status">
                          <select class="status-select" name="status">
                            <option value="scheduled" <%= appointment.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
                            <option value="confirmed" <%= appointment.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                            <option value="completed" <%= appointment.status === 'completed' ? 'selected' : '' %>>Completed</option>
                            <option value="cancelled" <%= appointment.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                          </select>
                          <button class="btn btn-secondary btn-sm" type="submit">Save</button>
                        </form>
                      </td>
                      <% } %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="empty-state">No appointments found. Add patients and doctors before booking.</p>
          <% } %>
        </section>
      </main>
    </div>
  </body>
</html>
